<?xml version="1.0" encoding="UTF-8"?>
<!-- O pom.xml é o arquivo de configuração do Maven: diz quais bibliotecas o projeto usa e como compilar. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<!-- Versão do formato do pom (sempre 4.0.0). -->
	<modelVersion>4.0.0</modelVersion>
	<!-- Herdamos do "pai" do Spring Boot, que já define versões compatíveis de todas as bibliotecas Spring. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<!-- Identificação do nosso projeto (grupo, nome e versão). -->
	<groupId>com.clinica</groupId>
	<artifactId>gestao-clinica</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>gestao-clinica</name>
	<description>API RESTful para gestão de clínicas médicas</description>
	<properties>
		<!-- Versão do Java usada para compilar (a mesma da imagem Docker). -->
		<java.version>21</java.version>
		<!-- Versão do springdoc (Swagger). A linha 3.x é a compatível com o Spring Boot 4. -->
		<springdoc.version>3.1.1</springdoc.version>
	</properties>
	<dependencies>
		<!-- Spring Data JPA + Hibernate: acesso ao banco de dados usando entidades e repositórios. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Biblioteca da Auth0 para criar e validar tokens JWT. -->
		<dependency>
			<groupId>com.auth0</groupId>
			<artifactId>java-jwt</artifactId>
			<version>4.5.0</version>
		</dependency>
		<!-- Spring Security: autenticação (quem é você) e autorização (o que você pode fazer). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- Bean Validation: anotações como @NotBlank, @Email e @Future nos DTOs. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Spring MVC: cria a API REST (controllers, JSON, servidor Tomcat embutido). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Swagger / OpenAPI: documentação interativa em /swagger-ui.html. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<!-- DevTools: reinicia a aplicação automaticamente durante o desenvolvimento. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<!-- Driver do MySQL, usado só em tempo de execução para conectar no banco. -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Lombok: gera getters, setters e construtores automaticamente na compilação. -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- H2: banco de dados em memória usado APENAS nos testes (scope test). -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Ferramentas de teste para JPA (@DataJpaTest). Já trazem JUnit 5, Mockito e AssertJ. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Ferramentas de teste para o Spring Security. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Ferramentas de teste para Bean Validation. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Ferramentas de teste para Spring MVC (MockMvc, para simular requisições HTTP). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Plugin do Spring Boot: empacota tudo em um único .jar executável (java -jar). -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- O Lombok só é necessário na compilação, então não entra no .jar final. -->
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<!-- Plugin do compilador Java: precisa saber do Lombok para gerar o código antes de compilar. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<!-- Compilação do código principal (src/main). -->
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<!-- Compilação do código de testes (src/test). -->
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
