# Modelo de variáveis para o docker-compose.
# Copie para ".env" (que está no .gitignore) e troque os valores.

# Senha do root do MySQL.
DB_PASSWORD=clinica123
# Chave para assinar os tokens JWT (use um texto longo e aleatório).
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
# Administrador criado no primeiro start.
ADMIN_EMAIL=admin@clinica.com
ADMIN_SENHA=admin123
# Sites que podem chamar a API pelo navegador (separados por vírgula).
CORS_ORIGENS=http://localhost:4200
